# ==============================================================================
# GHANA FINTECH PLATFORM: ENVIRONMENT CONFIGURATION
# Currency: Ghana Cedis (GHS / GH₵) | Timezone: Africa/Accra
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="Ghana MoMo & Telecom Hub"
BUSINESS_NAME="Blessings Telecom & Financial Services Ltd."
BUSINESS_PHONE="+233240000000"
BUSINESS_EMAIL="support@blessingstelecom.com.gh"
SECRET_KEY=generate_a_secure_random_hex_key_at_least_32_chars
JWT_SECRET_KEY=generate_a_separate_secure_jwt_secret_key_at_least_32_chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14
LOG_LEVEL=INFO

# Database Connection (MySQL 8.0)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ghana_fintech_db
# Test / Fallback SQLite URL (if MySQL is unavailable during local unit tests)
SQLITE_FALLBACK_URL=sqlite:///ghana_fintech_dev.db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0
TASK_WORKER_ENABLED=true
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=30

# MTN MoMo Open API (Sandbox Defaults)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_COLLECTION_SUBSCRIPTION_KEY=YOUR_COLLECTIONS_SANDBOX_SUBSCRIPTION_KEY
MOMO_API_USER=YOUR_SANDBOX_API_USER_UUID
MOMO_API_KEY=YOUR_SANDBOX_API_KEY
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=YOUR_DISBURSEMENTS_SUBSCRIPTION_KEY
MOMO_CALLBACK_BASE_URL=https://your-https-backend-domain.com
MOMO_REQUEST_TIMEOUT_SECONDS=30

# Hubtel Developer API (Alternative Aggregator for MoMo, Airtime & SMS)
HUBTEL_CLIENT_ID=YOUR_HUBTEL_CLIENT_ID
HUBTEL_CLIENT_SECRET=YOUR_HUBTEL_CLIENT_SECRET
HUBTEL_MERCHANT_ACCOUNT_NUMBER=YOUR_HUBTEL_MERCHANT_ACCOUNT
HUBTEL_WEBHOOK_SECRET=YOUR_HUBTEL_WEBHOOK_SECRET

# Paystack API (Cards & Ghanaian Mobile Money)
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET

# Airtime and Data Distribution Provider
# Options: MOCK, HUBTEL, RELOADLY, AT_BUSINESS, CUSTOM_AGGREGATOR
AIRTIME_PROVIDER=MOCK
AIRTIME_API_BASE_URL=https://api.airtimeprovider.com/v1
AIRTIME_API_KEY=YOUR_AIRTIME_API_KEY
AIRTIME_API_SECRET=YOUR_AIRTIME_API_SECRET
AIRTIME_WEBHOOK_SECRET=YOUR_AIRTIME_WEBHOOK_SECRET

# SMS Gateway Configuration
SMS_PROVIDER=MOCK
SMS_SENDER_ID=BLESSINGS
SMS_API_KEY=YOUR_SMS_API_KEY

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:3000
